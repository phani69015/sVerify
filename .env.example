# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Postgres (app data) ---
DATABASE_URL=postgresql://sverify:sverify@localhost:5432/sverify

# --- MinIO / S3 (media storage) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sverify
S3_SECRET_KEY=sverify123
S3_MEDIA_BUCKET=sverify-media

# --- Qdrant (evidence vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_EVIDENCE_COLLECTION=evidence

# --- Redis (verify-result cache - see apps/api/src/routes/verify.ts) ---
# Same post URL submitted again within VERIFY_CACHE_TTL_SECONDS of a
# COMPLETE result returns the cached result instantly, skipping extraction/
# ML/LLM entirely. Never used for x-mock:true requests.
REDIS_URL=redis://localhost:6379
VERIFY_CACHE_TTL_SECONDS=3600

# --- Hugging Face Inference Endpoints (models run remotely on HF) ---
# Toggle: point these at a local model-serving utility instead (e.g.
# model-inference-hub's /hf-compat/* routes) for dev without real HF
# endpoints - no code changes needed, this project only knows a URL + token.
HF_API_TOKEN=hf_xxx
HF_DEEPFAKE_ENDPOINT_URL=https://xxxx.endpoints.huggingface.cloud
HF_WHISPER_ENDPOINT_URL=https://xxxx.endpoints.huggingface.cloud
HF_EMBEDDING_ENDPOINT_URL=https://xxxx.endpoints.huggingface.cloud
HF_LLM_ENDPOINT_URL=https://xxxx.endpoints.huggingface.cloud

# --- Web search (evidence retrieval) ---
# Toggle: set SEARCH_ENABLED=false to skip web search entirely (no paid API
# key needed) - claims will just resolve with no evidence -> UNVERIFIED
# verdict, instead of failing the activity.
#
# For local dev without a paid search API, point SEARCH_API_URL at a
# Bing-shaped compat adapter backed by a self-hosted, keyless SearXNG
# instance (see model-inference-hub/adapters/search_compat) instead of a
# real provider, e.g.:
#   SEARCH_API_URL=http://localhost:8500/search-compat/bing
#   SEARCH_API_KEY=local-dev-key   # unused by the adapter, just needs to be non-empty
SEARCH_ENABLED=true
SEARCH_API_URL=https://api.bing.microsoft.com/v7.0/search
SEARCH_API_KEY=xxx

# --- API ---
# Note: 4000 may already be in use on some machines - change if needed
PORT=4000

# --- extraction-sidecar (platform scraping HTTP service, apps/extraction-sidecar) ---
EXTRACTION_SIDECAR_URL=http://localhost:4200
